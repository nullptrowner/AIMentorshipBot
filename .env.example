# Generate separate 32+ character secrets. Never commit .env.
BOT_TOKEN=
ADMIN_IDS=[]
PUBLIC_URL=https://bot.example.com
DOMAIN=bot.example.com
TELEGRAM_SECRET=
MEDIA_SECRET=
REPLICATE_TOKEN=
REPLICATE_WEBHOOK_SECRET=
CRYPTO_TOKEN=
CRYPTO_TESTNET=true
# Keep false for digital goods sold inside Telegram. Crypto adapter can be tested separately.
CRYPTO_SALES_ENABLED=false
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://studio:CHANGE_ME@postgres:5432/studio
REDIS_URL=redis://redis:6379/0
MEDIA_DIR=/app/data/media
MEDIA_QUOTA_BYTES=10000000000
MAX_UPLOAD_BYTES=20000000
MAX_OUTPUT_BYTES=49000000
MAX_AUDIO_SECONDS=120
CONCURRENT_GENERATIONS=10
MEDIA_CONCURRENCY=1
POLL_SECONDS=15
JOB_TIMEOUT_SECONDS=3600
QUOTE_TTL_SECONDS=600
# Required. Choose retention before first launch; zero deliberately prevents startup.
INPUT_RETENTION_HOURS=0
OUTPUT_RETENTION_HOURS=0
LOG_LEVEL=INFO
